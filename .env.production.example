# Copy to .env.production on the Debian server. Never commit the filled file.
COMPOSE_PROJECT_NAME=ai-digest
APP_HTTP_BIND=127.0.0.1
APP_HTTP_PORT=8080

DJANGO_SECRET_KEY=replace-with-a-long-random-value
ERASURE_HASH_KEY=replace-with-another-long-random-value
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=digest.internal.example
DJANGO_CSRF_TRUSTED_ORIGINS=https://digest.internal.example
DJANGO_TRUST_PROXY=1
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_HSTS_SECONDS=31536000

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=digest
POSTGRES_USER=digest
POSTGRES_PASSWORD=replace-with-a-random-database-password

RABBITMQ_USER=digest
RABBITMQ_PASSWORD=replace-with-a-random-broker-password
# URL-encode special characters in the RabbitMQ password used in this URL.
CELERY_BROKER_URL=amqp://digest:replace-with-a-random-broker-password@broker:5672//

SOURCE_HTTP_USER_AGENT=OwnedDigestBot/1.0 (+mailto:replace-with-operations-contact@example.com)
SOURCE_COLLECTION_INTERVAL_MINUTES=15

OPENROUTER_API_KEY=replace-with-the-existing-openrouter-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_TITLE=Owned AI Digest
AI_RU_MODEL=openai/gpt-5.4
AI_EN_MODEL=openai/gpt-5-mini
AI_RU_INPUT_USD_PER_MTOK=2.50
AI_RU_OUTPUT_USD_PER_MTOK=15.00
AI_EN_INPUT_USD_PER_MTOK=0.25
AI_EN_OUTPUT_USD_PER_MTOK=2.00
AI_MONTHLY_BUDGET_USD=25.00

TELEGRAM_BOT_TOKEN=replace-with-the-existing-bot-token
TELEGRAM_WEBHOOK_SECRET=replace-with-the-existing-webhook-secret
TELEGRAM_SOURCE_API_ID=123456
TELEGRAM_SOURCE_API_HASH=replace-with-the-existing-api-hash
TELEGRAM_SOURCE_PHONE=+10000000000
TELEGRAM_SOURCE_SESSION_PATH=/run/secrets/telethon/source
TELEGRAM_SOURCE_EDIT_LOOKBACK=20

BACKGROUND_JOB_LEASE_SECONDS=120
AUTOMATIC_DIGEST_JOB_LEASE_SECONDS=2100
SERVICE_PROCESS_LEASE_SECONDS=300
TELEGRAM_IN_FLIGHT_TIMEOUT_SECONDS=600
CELERY_TASK_SOFT_TIME_LIMIT=1500
CELERY_TASK_TIME_LIMIT=1800

BACKUP_HOST_PATH=/srv/ai-digest/backups
ERASURE_GUARD_HOST_PATH=/srv/ai-digest/erasure-guard
BACKUP_OUTPUT_DIR=/backups
BACKUP_STORAGE_CLASS=external
BACKUP_ALLOW_SQLITE_TRAINING=0
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE_ENABLED=1
BACKUP_RESTORE_DATABASE_PREFIX=digest_restore_
ERASURE_GUARD_OUTPUT_DIR=/erasure-guard
ERASURE_GUARD_STORAGE_CLASS=external
ERASURE_GUARD_BACKUP_RETENTION_DAYS=60
ERASURE_GUARD_DAYS=45
DELIVERY_RECOVERY_GUARD_REQUIRED=1
BACKUP_AGE_RECIPIENT=age1replace_with_public_recipient
BACKUP_AGE_IDENTITY_FILE=/run/secrets/backup_age_identity
