{
  "schema_version": "0.1",
  "policy_version": "editorial-0.1",
  "status": "design_defaults_pending_pilot_validation",
  "as_of": "2026-09-09",
  "source_language_policy": "original_language_preserved",
  "canonical_digest_language": "ru",
  "output_languages": ["ru", "en"],
  "english_mode": "translation_of_final_russian_revision",
  "english_variant": "international_english_british_spelling",
  "english_preserve_event_order": true,
  "english_preserve_source_urls": true,
  "english_add_external_facts": false,
  "english_revision_binding_required": true,
  "full_article_translation_feature": "not_decided_separately",
  "eligibility": {
    "reliability_is_required_gate": true,
    "material_claim_evidence_required": true,
    "ordinary_disputed_fact_independent_origins_target": 2,
    "primary_source_for_own_action_allowed": true,
    "primary_source_proves_own_statement_not_its_truth": true,
    "single_media_source_exception": "automatic_attribution_with_corroboration_penalty",
    "anonymous_source_handling": "exclude_when_automatic_checks_cannot_support_claims",
    "unresolved_material_conflict": "attribute_versions_or_hold",
    "unverified_rumor": "exclude",
    "advertisement_without_news": "exclude",
    "low_quality_cannot_be_overridden_by_popularity": true
  },
  "ranking": {
    "scale_min": 0,
    "scale_max": 5,
    "weights_percent": {
      "impact": 35,
      "relevance": 25,
      "novelty": 20,
      "timeliness": 10,
      "corroboration": 10
    },
    "formula": "sum(weight_percent * component_score / 5)",
    "main_min_score": 60,
    "main_min_impact": 3,
    "min_relevance": 3,
    "extra_min_score": 40,
    "reason_per_component_required": true,
    "views_and_reactions_weight": 0,
    "duplicate_origin_adds_corroboration": false,
    "manual_threshold_override_requires_reason": true,
    "manual_reliability_gate_override_allowed": false,
    "tie_break": ["impact", "novelty", "timeliness", "event_id"]
  },
  "composition": {
    "item_limits_scope": "per_collection_edition",
    "multi_collection_mode": "full_collection_blocks",
    "multi_collection_global_story_cap": null,
    "multi_collection_policy_ref": "config/user_flow_policy.json",
    "main_max_items": 10,
    "main_typical_min_items": 5,
    "main_min_is_not_a_quota": true,
    "extra_max_items": 5,
    "empty_extra_block": "omit",
    "empty_main": "omit_main_and_publish_eligible_extra_if_any",
    "both_blocks_empty": "no_sufficiently_supported_news_for_this_edition_message",
    "title_soft_max_characters": 120,
    "ru_main_summary_soft_characters": [300, 700],
    "ru_extra_summary_soft_characters": [150, 400],
    "main_visible_sources_max": 6,
    "main_visible_sources_must_cover_material_claims": true,
    "all_supporting_source_references_retained_for_edition_lifetime": true,
    "source_text_and_evidence_retention_policy_ref": "config/data_retention_policy.json",
    "extra_primary_link_location": "headline",
    "extra_additional_evidence_links_allowed": true,
    "deduplicate_between_blocks": true,
    "deduplicate_merged_daily_across_collections": true,
    "deduplicate_merged_delivery_across_collections": true,
    "intraday_repeat_requires_material_update": true,
    "daily_can_include_events_previously_in_intraday": true,
    "weekly_can_include_events_previously_in_shorter_editions": true,
    "weekly_merge_event_developments_and_apply_corrections": true,
    "include_items_to_fill_quota": false,
    "topic_diversity": "soft_constraint_after_importance",
    "political_viewpoint_quota": false
  },
  "rendering": {
    "telegram_parse_mode": "HTML",
    "telegram_api_limit_visible_characters": 4096,
    "internal_visible_utf16_units_limit": 3900,
    "html_and_urls_excluded_from_visible_length": true,
    "split_between_story_blocks": true,
    "allow_different_part_count_per_language": true,
    "headings": {
      "ru": {"digest": "Дайджест", "main": "Главные темы", "extra": "Ещё несколько интересных сюжетов"},
      "en": {"digest": "News digest", "main": "Top stories", "extra": "Also worth a look"}
    },
    "en_date_format": "D MMM",
    "timezone": "Europe/Moscow"
  },
  "review_and_corrections": {
    "pilot_manual_review": false,
    "automatic_generation_and_publication": true,
    "administrator_can_override_sources_routes_and_results": true,
    "material_translation_drift": "hold_english_version",
    "russian_revision_changed": "invalidate_english_until_updated",
    "material_error_after_delivery": "version_both_languages_and_notify_eligible_affected_recipients_within_index_retention",
    "recipient_index_retention_days": 90,
    "correction_delivery_requires_active_subscription_and_normal_privacy_state": true,
    "typographical_error": "version_without_separate_notification",
    "audit_log_required": true
  }
}
