{
  "schema_version": "0.1",
  "policy_id": "retention-v1-draft",
  "status": "proposed_product_defaults_not_implemented",
  "default_source_retention_policy_id": "news_default_v1",
  "source_retention_profiles": [
    {"id": "news_default_v1", "status": "default_pending_source_specific_access_review", "category_refs": ["source_text_versions", "source_evidence_fragments", "source_embeddings_and_working_copies", "temporary_extraction_files", "published_source_references_and_hashes"]}
  ],
  "expiry_enforced_before_physical_purge": true,
  "cleanup_interval_hours": 24,
  "post_expiry_purge_max_hours": 24,
  "unchanged_fetch_or_read_extends_lifetime": false,
  "categories": {
    "source_text_versions": {"days": 90, "anchor": "version_first_seen_at"},
    "source_evidence_fragments": {"inherits_expiry_from": "source_text_versions", "copying_fragment_resets_expiry": false},
    "source_embeddings_and_working_copies": {"inherits_expiry_from": "source_text_versions"},
    "temporary_extraction_files": {"hours": 24, "anchor": "created_at"},
    "published_editions_and_revisions": {"days": 365, "anchor": "edition_first_published_at"},
    "published_event_cards": {"expires_when": "last_referencing_edition_expires"},
    "published_source_references_and_hashes": {"expires_when": "last_referencing_edition_expires", "full_source_text_allowed": false},
    "unpublished_drafts_and_unused_events": {"days": 14, "anchor": "created_at", "retries_extend_lifetime": false},
    "incomplete_user_setup": {"days": 7, "anchor": "last_user_action_at"},
    "active_user_profile": {"retained_while": "subscription_active_and_chat_not_confirmed_unreachable", "on_pause_or_confirmed_unreachability": "apply_paused_or_unreachable_profile_policy", "erasure_request_takes_precedence": true, "absence_of_commands_alone_expires_active_profile": false},
    "paused_or_unreachable_profile": {"days": 365, "anchor": "max(state_entered_at,last_user_action_at)", "on_expiry": "profile_erasure_workflow"},
    "feedback_and_attachment_references": {"days": 90, "anchor": "received_at", "profile_erasure_deletes_earlier": true},
    "detailed_delivery_attempts": {"days": 30, "anchor": "attempted_at"},
    "minimal_recipient_edition_index": {"days": 90, "anchor": "delivered_at", "copy_of_digest_text_allowed": false},
    "technical_logs": {"days": 14, "anchor": "created_at", "raw_content_and_secrets_allowed": false},
    "ai_usage_records": {"days": 90, "anchor": "created_at", "full_prompts_allowed": false, "subscriber_ids_allowed": false},
    "admin_audit": {"days": 365, "anchor": "created_at", "user_content_in_change_payload_allowed": false},
    "aggregate_operational_metrics": {"days": 365, "anchor": "metric_day", "subscriber_identifiers_or_hashes_allowed": false},
    "completed_and_failed_queue_jobs": {"days": 7, "anchor": "terminal_at", "full_source_text_in_payload_allowed": false},
    "settings_drafts_and_feedback_wait": {"minutes": 30, "anchor": "last_dialog_action_at"},
    "erasure_confirmation": {"minutes": 5, "anchor": "confirmation_screen_created_at"},
    "temporary_personal_data_export": {"hours": 24, "anchor": "created_at"},
    "erasure_restore_guard": {"days": 45, "anchor": "working_erasure_completed_at", "is_anonymous": false},
    "minimal_remaining_access_restriction": {"maximum_days_after_profile_erasure": 90, "ends_earlier_if_restriction_expires": true}
  },
  "data_minimization": {
    "subscriber_fields_required": ["telegram_user_id", "telegram_chat_id", "account_generation_id", "interface_language", "digest_language", "collection_ids", "schedule_id", "state_dimensions", "preference_revision", "registered_at", "last_user_action_at"],
    "subscriber_fields_not_collected_by_default": ["phone", "email", "contacts", "other_chat_history", "first_name", "last_name", "username"],
    "ordinary_message_text_logging": false,
    "feedback_in_ai_news_pipeline": false,
    "subscriber_data_in_ai_news_pipeline": false,
    "raw_prompt_trace_storage_enabled": false,
    "external_ai_provider_retention": "to_be_verified_when_provider_is_selected"
  },
  "source_overrides": {
    "source_retention_policy_required": true,
    "stricter_source_limit_overrides_default": true,
    "applies_to_relevant_derivatives_and_backups": true,
    "physical_purge_lag_counts_towards_hard_deadline": true,
    "cannot_meet_hard_limit": "do_not_activate_until_compatible_storage_route_is_verified",
    "longer_config_does_not_restore_deleted_content": true,
    "background_reads_extend_retention": false
  },
  "profile_erasure": {
    "entrypoint": "settings_my_data_delete_my_data",
    "confirmation_required": true,
    "confirmation_bound_to_user_and_account_generation": true,
    "working_systems_max_hours": 24,
    "cancel_after_acceptance_supported": false,
    "privacy_states_while_profile_exists": ["normal", "erasure_pending"],
    "cancel_pending_automatic_delivery_immediately": true,
    "manual_digest_during_erasure_allowed": false,
    "delete": ["profile", "subscriptions", "settings_drafts", "feedback_and_our_attachment_copies", "pending_user_jobs", "delivery_attempts", "recipient_edition_index", "user_links_in_audits_and_caches"],
    "later_start": "new_account_generation_and_onboarding",
    "previous_preferences_restored": false,
    "erasure_guard_fields": ["operation_id", "protected_old_account_generation_key", "requested_at", "completed_at", "status"],
    "remaining_restriction_is_disclosed_if_applicable": true,
    "our_erasure_implies_external_platform_history_erasure": false,
    "optional_admin_group_residuals": "track_remove_where_supported_and_report_unresolved_items"
  },
  "backups": {
    "maximum_interval_hours": 24,
    "snapshot_retention_days": 30,
    "separate_storage_required": true,
    "encryption_required": true,
    "ordinary_product_reads_from_backups_allowed": false,
    "personal_record_residual_max_days_after_working_erasure": 30,
    "worst_case_days_after_confirmed_profile_erasure_request": 31,
    "strict_source_all_copy_deadline_overrides_normal_rotation": true,
    "erasure_guard_independent_of_restored_snapshot": true,
    "erasure_guard_minimum_margin_days_over_backup_retention": 7,
    "validate_guard_lifetime_when_backup_retention_changes": true,
    "apply_expiry_and_erasure_guard_before_service_restart": true,
    "send_if_current_erasure_guard_unavailable": false,
    "restore_snapshot_older_than_retention_allowed": false,
    "target_recovery_point_hours": 24,
    "target_recovery_time_hours": 4,
    "restore_exercise_before_pilot_required": true,
    "recovery_targets_measured": false
  },
  "corrections": {
    "addressable_recipient_index_days": 90,
    "require_active_subscription_and_current_delivery_permission": true,
    "send_to_paused_or_erasure_pending_profiles": false,
    "after_recipient_index_expiry": "correct_retained_edition_without_promise_to_notify_all_historical_recipients"
  },
  "admin_controls": {
    "versioned_policy": true,
    "preview_before_shortening_retention": true,
    "show_affected_categories_and_counts": true,
    "incremental_idempotent_cleanup": true,
    "show_partial_failures_and_actual_residuals": true,
    "deletion_request_status_visible": true,
    "secrets_in_catalog_export_allowed": false
  }
}
